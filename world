  {name:"إكوادور",nameEn:"Ecuador",flag:"🇪🇨",code:"+593",len:9,prefixes:["09"]},
  {name:"بوليفيا",nameEn:"Bolivia",flag:"🇧🇴",code:"+591",len:8,prefixes:["6","7"]},
  {name:"فنزويلا",nameEn:"Venezuela",flag:"🇻🇪",code:"+58",len:10,prefixes:["04"]},
  {name:"كوبا",nameEn:"Cuba",flag:"🇨🇺",code:"+53",len:8,prefixes:["5"]},
  {name:"جامايكا",nameEn:"Jamaica",flag:"🇯🇲",code:"+1876",len:7,prefixes:[""]},
  {name:"إيرلندا",nameEn:"Ireland",flag:"🇮🇪",code:"+353",len:9,prefixes:["08"]},
  {name:"النمسا",nameEn:"Austria",flag:"🇦🇹",code:"+43",len:10,prefixes:["06"]},
  {name:"التشيك",nameEn:"Czech Republic",flag:"🇨🇿",code:"+420",len:9,prefixes:["6","7"]},
  {name:"كرواتيا",nameEn:"Croatia",flag:"🇭🇷",code:"+385",len:9,prefixes:["09"]},
  {name:"صربيا",nameEn:"Serbia",flag:"🇷🇸",code:"+381",len:9,prefixes:["06"]},
  {name:"أذربيجان",nameEn:"Azerbaijan",flag:"🇦🇿",code:"+994",len:9,prefixes:["05","07"]},
  {name:"جورجيا",nameEn:"Georgia",flag:"🇬🇪",code:"+995",len:9,prefixes:["5","7","9"]},
  {name:"كازاخستان",nameEn:"Kazakhstan",flag:"🇰🇿",code:"+7",len:10,prefixes:["7"]},
  {name:"أوزبكستان",nameEn:"Uzbekistan",flag:"🇺🇿",code:"+998",len:9,prefixes:["9"]},
  {name:"المغرب الأقصى",nameEn:"Comoros",flag:"🇰🇲",code:"+269",len:7,prefixes:["3","7","9"]},
];

// State
let selectedCountry = null;
let currentFormat = 'plain';
let currentNumbers = [];
let filteredCountries = [...COUNTRIES];

// ===== INIT =====
function init() {
  renderDropdown(COUNTRIES);
  // Default: Libya
  selectCountry(COUNTRIES[0]);
}

function renderDropdown(list) {
  const dl = document.getElementById('dropdownList');
  if (list.length === 0) {
    dl.innerHTML = '<div style="padding:16px;text-align:center;color:var(--muted);font-size:0.85rem">لا توجد نتائج</div>';
    return;
  }
  dl.innerHTML = list.map((c,i) => `
    <div class="country-option" onclick="selectCountry(COUNTRIES[${COUNTRIES.indexOf(c)}])" id="opt-${COUNTRIES.indexOf(c)}">
      <span class="opt-flag">${c.flag}</span>
      <span class="opt-name">${c.name}</span>
      <span class="opt-code">${c.code}</span>
    </div>
  `).join('');
}

function filterCountries() {
  const q = document.getElementById('searchInput').value.trim().toLowerCase();
  filteredCountries = COUNTRIES.filter(c =>
    c.name.includes(q) ||
    c.nameEn.toLowerCase().includes(q) ||
    c.code.includes(q)
  );
  renderDropdown(filteredCountries);
}

function toggleDropdown() {
  const dl = document.getElementById('dropdownList');
  const sc = document.getElementById('selectedCountry');
  const ch = document.getElementById('chevron');
  const open = dl.classList.toggle('open');
  sc.classList.toggle('open', open);
  ch.classList.toggle('open', open);
}

function selectCountry(country) {
  selectedCountry = country;
  document.getElementById('selFlag').textContent = country.flag;
  document.getElementById('selName').textContent = country.name;
  document.getElementById('selCode').textContent = country.code;
  document.getElementById('dropdownList').classList.remove('open');
  document.getElementById('selectedCountry').classList.remove('open');
  document.getElementById('chevron').classList.remove('open');
  // Highlight active
  document.querySelectorAll('.country-option').forEach(el => el.classList.remove('active'));
  const idx = COUNTRIES.indexOf(country);
  const el = document.getElementById('opt-'+idx);
  if (el) el.classList.add('active');
}

function setFormat(fmt) {
  currentFormat = fmt;
  document.querySelectorAll('.fmt-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('fmt-'+fmt).classList.add('active');
  if (currentNumbers.length) rerender();
}

// ===== GENERATE =====
function randDigits(n) {
  let s='';
  for(let i=0;i<n;i++) s+=Math.floor(Math.random()*10);
  return s;
}

function makeNumber(country) {
  const prefix = country.prefixes.length
    ? country.prefixes[Math.floor(Math.random()*country.prefixes.length)]
    : '';
  const remaining = country.len - prefix.length;
  const rest = randDigits(remaining > 0 ? remaining : country.len);
  return { country, prefix, rest, local: prefix+rest };
}

function formatNumber(num) {
  const full = num.local;
  switch(currentFormat) {
    case 'plain': return num.country.code + full;
    case 'plus': return num.country.code + ' ' + full;
    case 'spaces': {
      const chunks = full.match(/.{1,3}/g) || [full];
      return num.country.code + ' ' + chunks.join(' ');
    }
    case 'dash': {
      const chunks = full.match(/.{1,3}/g) || [full];
      return num.country.code + '-' + chunks.join('-');
    }
    default: return num.country.code + full;
  }
}

function generate() {
  if (!selectedCountry) { showToast('اختر دولة أولاً'); return; }
  const qty = parseInt(document.getElementById('qtySelect').value);
  currentNumbers = Array.from({length: qty}, () => makeNumber(selectedCountry));
  rerender();
}

function rerender() {
  const list = document.getElementById('numbersList');
  const label = document.getElementById('outputLabel');
  const count = document.getElementById('outputCount');

  label.textContent = selectedCountry.flag + ' ' + selectedCountry.name;
  count.textContent = currentNumbers.length + ' رقم';

  list.innerHTML = '';
  currentNumbers.forEach((num, i) => {
    const formatted = formatNumber(num);
    const row = document.createElement('div');
    row.className = 'number-row';

    const idx = document.createElement('span');
    idx.className = 'row-idx';
    idx.textContent = i+1;

    const flag = document.createElement('span');
    flag.className = 'row-flag';
    flag.textContent = num.country.flag;

    const numEl = document.createElement('span');
    numEl.className = 'row-number';
    numEl.dir = 'ltr';
    numEl.innerHTML = `<span class="cc">${num.country.code}</span>${num.local}`;
    numEl.dataset.full = formatted;

    const copyBtn = document.createElement('button');
    copyBtn.className = 'copy-btn';
    copyBtn.textContent = 'نسخ';
    copyBtn.onclick = () => {
      navigator.clipboard.writeText(formatted).then(() => {
        copyBtn.textContent = '✓';
        copyBtn.classList.add('done');
        setTimeout(() => { copyBtn.textContent = 'نسخ'; copyBtn.classList.remove('done'); }, 1500);
      });
    };

    row.appendChild(idx);
    row.appendChild(flag);
    row.appendChild(numEl);
    row.appendChild(copyBtn);
    list.appendChild(row);
  });

  document.getElementById('copyAllBtn').textContent = '📋 نسخ الكل';
  document.getElementById('copyAllBtn').classList.remove('done');
}

function copyAll() {
  if (!currentNumbers.length) return;
  const text = currentNumbers.map(n => formatNumber(n)).join('\n');
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.getElementById('copyAllBtn');
    btn.textContent = '✓ تم النسخ';
    btn.classList.add('done');
    setTimeout(() => { btn.textContent = '📋 نسخ الكل'; btn.classList.remove('done'); }, 2000);
    showToast('تم نسخ ' + currentNumbers.length + ' رقم');
  });
}

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2200);
}

// Close dropdown on outside click
document.addEventListener('click', e => {
  if (!document.getElementById('dropdownWrap').contains(e.target)) {
    document.getElementById('dropdownList').classList.remove('open');
    document.getElementById('selectedCountry').classList.remove('open');
    document.getElementById('chevron').classList.remove('open');
  }
});

init();
</script>
