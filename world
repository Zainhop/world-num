        <span class="chevron" id="chevron">▼</span>
      </div>
    </div>
    <div class="dropdown-list" id="dropdownList"></div>
  </div>

  <!-- Format -->
  <div class="format-row">
    <button class="fmt-btn active" id="fmt-plain" onclick="setFormat('plain')">بدون مسافات</button>
    <button class="fmt-btn" id="fmt-spaces" onclick="setFormat('spaces')">مع مسافات</button>
    <button class="fmt-btn" id="fmt-dash" onclick="setFormat('dash')">مع شرطات</button>
    <button class="fmt-btn" id="fmt-plus" onclick="setFormat('plus')">+ رمز الدولة</button>
  </div>
</div>

<div class="action-row">
  <button class="btn-gen" onclick="generate()">⟳ توليد أرقام</button>
  <button class="btn-copy-all" id="copyAllBtn" onclick="copyAll()">📋 نسخ الكل</button>
</div>

<div class="output-wrap">
  <div class="output-card">
    <div class="output-top">
      <div class="output-meta"><div class="pulse"></div><span id="outputLabel">جاهز</span></div>
      <span class="output-count" id="outputCount"></span>
    </div>
    <div class="numbers-list" id="numbersList">
      <div class="empty-state">
        <div class="globe">🌐</div>
        <p>اختر دولة من القائمة<br>ثم اضغط <strong>توليد أرقام</strong></p>
      </div>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

