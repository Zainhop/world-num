<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>مولد أرقام هاتف  </title>
<style>
@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=Cairo:wght@400;600;800&display=swap');

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root{
  --bg:#08090c;
  --surface:#10131a;
  --card:#151920;
  --border:#1e2433;
  --border2:#2a3245;
  --accent:#4f9eff;
  --accent-dim:#1a3566;
  --gold:#f5c842;
  --text:#dde4f0;
  --muted:#4a5570;
  --muted2:#6b7a99;
  --mono:'IBM Plex Mono',monospace;
  --sans:'Cairo',sans-serif;
  --radius:8px;
}

body{
  background:var(--bg);
  color:var(--text);
  font-family:var(--sans);
  min-height:100vh;
  padding:32px 16px 60px;
  display:flex;
  flex-direction:column;
  align-items:center;
}

/* HEADER */
.hero{text-align:center;margin-bottom:32px}
.hero-label{
  font-family:var(--mono);
  font-size:0.7rem;
  letter-spacing:3px;
  text-transform:uppercase;
  color:var(--accent);
  margin-bottom:10px;
}
.hero h1{
  font-size:2.1rem;
  font-weight:800;
  line-height:1.2;
  color:var(--text);
}
.hero h1 em{
  font-style:normal;
  color:var(--accent);
}
.hero p{color:var(--muted2);font-size:0.88rem;margin-top:8px}

/* SEARCH & SELECT */
.controls-wrap{
  width:100%;
  max-width:560px;
  display:flex;
  flex-direction:column;
  gap:12px;
  margin-bottom:20px;
}

.search-row{
  display:flex;
  gap:10px;
  align-items:stretch;
}

.search-box{
  position:relative;
  flex:1;
}
.search-box input{
  width:100%;
  background:var(--surface);
  border:1px solid var(--border2);
  border-radius:var(--radius);
  color:var(--text);
  font-family:var(--sans);
  font-size:0.9rem;
  padding:10px 16px 10px 40px;
  outline:none;
  transition:border 0.15s;
}
.search-box input::placeholder{color:var(--muted)}
.search-box input:focus{border-color:var(--accent)}
.search-icon{
  position:absolute;
  left:12px;top:50%;
  transform:translateY(-50%);
  color:var(--muted);
  font-size:0.9rem;
  pointer-events:none;
}

.qty-select{
  background:var(--surface);
  border:1px solid var(--border2);
  border-radius:var(--radius);
  color:var(--text);
  font-family:var(--sans);
  font-size:0.9rem;
  padding:10px 14px;
  outline:none;
  cursor:pointer;
}

/* DROPDOWN */
.dropdown-wrap{position:relative;width:100%}
.selected-country{
  width:100%;
  background:var(--surface);
  border:1px solid var(--border2);
  border-radius:var(--radius);
  color:var(--text);
  font-family:var(--sans);
  font-size:0.9rem;
  padding:11px 16px;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  transition:border 0.15s;
  user-select:none;
}
.selected-country:hover,.selected-country.open{border-color:var(--accent)}
.selected-left{display:flex;align-items:center;gap:10px}
.sel-flag{font-size:1.2rem}
.sel-name{font-size:0.9rem}
.sel-code{font-family:var(--mono);font-size:0.8rem;color:var(--accent)}
.chevron{color:var(--muted);font-size:0.7rem;transition:transform 0.2s}
.chevron.open{transform:rotate(180deg)}

.dropdown-list{
  display:none;
  position:absolute;
  top:calc(100% + 6px);
  left:0;right:0;
  background:var(--card);
  border:1px solid var(--border2);
  border-radius:var(--radius);
  max-height:260px;
  overflow-y:auto;
  z-index:100;
  box-shadow:0 8px 32px rgba(0,0,0,0.5);
}
.dropdown-list.open{display:block}
.dropdown-list::-webkit-scrollbar{width:4px}
.dropdown-list::-webkit-scrollbar-track{background:transparent}
.dropdown-list::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px}

.country-option{
  display:flex;
  align-items:center;
  gap:10px;
  padding:10px 14px;
  cursor:pointer;
  transition:background 0.1s;
  font-size:0.88rem;
}
.country-option:hover{background:var(--surface)}
.country-option.active{background:var(--accent-dim)}
.opt-flag{font-size:1.1rem;flex-shrink:0}
.opt-name{flex:1;color:var(--text)}
.opt-code{font-family:var(--mono);font-size:0.78rem;color:var(--accent);flex-shrink:0}

/* FORMAT TOGGLE */
.format-row{
  display:flex;gap:8px;flex-wrap:wrap;
}
.fmt-btn{
  font-family:var(--sans);
  font-size:0.8rem;
  padding:6px 14px;
  border-radius:20px;
  border:1px solid var(--border2);
  background:transparent;
  color:var(--muted2);
  cursor:pointer;
  transition:all 0.15s;
}
.fmt-btn.active{
  background:var(--accent-dim);
  border-color:var(--accent);
  color:var(--accent);
}

/* ACTION BUTTONS */
.action-row{
  display:flex;gap:10px;flex-wrap:wrap;justify-content:center;
  margin-bottom:24px;
}
.btn-gen{
  font-family:var(--sans);
  font-weight:700;
  font-size:0.95rem;
  padding:11px 32px;
  background:var(--accent);
  color:#08090c;
  border:none;
  border-radius:var(--radius);
  cursor:pointer;
  transition:all 0.15s;
}
.btn-gen:hover{background:#78b8ff;transform:translateY(-1px)}
.btn-copy-all{
  font-family:var(--sans);
  font-weight:600;
  font-size:0.9rem;
  padding:11px 24px;
  background:transparent;
  border:1px solid var(--border2);
  color:var(--muted2);
  border-radius:var(--radius);
  cursor:pointer;
  transition:all 0.15s;
}
.btn-copy-all:hover{border-color:var(--accent);color:var(--accent)}
.btn-copy-all.done{border-color:var(--accent);color:var(--accent)}

/* OUTPUT */
.output-wrap{width:100%;max-width:560px}
.output-card{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:10px;
  overflow:hidden;
}
.output-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:12px 18px;
  border-bottom:1px solid var(--border);
  background:var(--card);
}
.output-meta{display:flex;align-items:center;gap:8px;font-size:0.78rem;color:var(--muted2)}
.pulse{
  width:7px;height:7px;border-radius:50%;
  background:var(--accent);
  animation:pulse 2s infinite;
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.3}}
.output-count{font-family:var(--mono);font-size:0.78rem;color:var(--muted)}

.numbers-list{padding:6px 0;min-height:120px}

.number-row{
  display:flex;
  align-items:center;
  gap:0;
  padding:8px 14px;
  transition:background 0.1s;
  border-bottom:1px solid transparent;
}
.number-row:hover{background:var(--card)}
.row-idx{
  font-family:var(--mono);
  font-size:0.68rem;
  color:var(--muted);
  width:24px;
  flex-shrink:0;
  text-align:right;
}
.row-flag{font-size:1rem;margin:0 10px;flex-shrink:0}
.row-number{
  flex:1;
  font-family:var(--mono);
  font-size:0.97rem;
  font-weight:600;
  color:var(--text);
  direction:ltr;
  letter-spacing:0.5px;
}
.row-number .cc{color:var(--accent)}
.row-country{
  font-size:0.72rem;
  color:var(--muted);
  margin-left:10px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
  max-width:90px;
  direction:rtl;
  text-align:left;
}
.copy-btn{
  font-size:0.68rem;
  padding:3px 9px;
  background:transparent;
  border:1px solid var(--border2);
  color:var(--muted);
  border-radius:4px;
  cursor:pointer;
  flex-shrink:0;
  margin-right:4px;
  transition:all 0.15s;
  font-family:var(--sans);
}
.copy-btn:hover{border-color:var(--accent);color:var(--accent)}
.copy-btn.done{color:var(--accent);border-color:var(--accent-dim)}

.empty-state{
  text-align:center;
  padding:48px 20px;
  color:var(--muted);
}
.empty-state .globe{font-size:2.5rem;margin-bottom:12px}
.empty-state p{font-size:0.88rem;line-height:1.8}

/* TOAST */
.toast{
  position:fixed;bottom:28px;left:50%;
  transform:translateX(-50%) translateY(20px);
  background:var(--accent);
  color:#08090c;
  font-family:var(--sans);
  font-weight:700;
  font-size:0.88rem;
  padding:10px 24px;
  border-radius:30px;
  opacity:0;
  transition:all 0.3s;
  pointer-events:none;
  z-index:999;
  white-space:nowrap;
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
</style>
</head>
